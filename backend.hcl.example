# Points OpenTofu at a bucket in VULTR OBJECT STORAGE.
#
# Normally you do not write this by hand -- `scripts/bootstrap-backend.sh`
# generates it from the Vultr API. Copy this only if you want to fill it in
# manually, then: tofu init -backend-config=backend.hcl
#
# backend.hcl is gitignored. In CI the same file is generated by the
# .github/actions/tofu-init composite action from repository variables.
#
# No credentials live here. They come from the environment; see backend.tf.

bucket = "crackbox-tfstate"

# Signing region only. Vultr ignores it, but the S3 protocol requires a
# syntactically valid region to compute the request signature. It does NOT
# need to match your Vultr cluster -- leave it as us-east-1.
region = "us-east-1"

endpoints = {
  # Your Vultr Object Storage hostname, without the bucket name.
  # Portal: Products -> Objects -> your subscription -> S3 Hostname.
  # Or: scripts/bootstrap-backend.sh --list
  s3 = "https://ewr1.vultrobjects.com"
}
