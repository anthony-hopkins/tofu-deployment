#cloud-config
# Managed by OpenTofu -- project=${project} instance=${instance_key}
#
# cloud-init only executes on FIRST BOOT. Editing this template and applying
# updates the user data Vultr has on file but changes nothing on a running
# machine; you must reinstall or rebuild the instance to re-run it.

hostname: ${hostname}
fqdn: ${fqdn}
manage_etc_hosts: true

%{ if docker ~}
# Created here, before the users module runs, so ${admin_user} can be added to
# it at creation time. docker-ce's postinst adopts the existing group.
groups:
  - docker

%{ endif ~}
users:
  - default
  - name: ${admin_user}
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
%{ if docker ~}
    groups: [docker]
%{ endif ~}
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - ${key}
%{ endfor ~}

# The random password is generated on the instance and printed only to the
# serial console log (Vultr web console). SSH never accepts it -- password
# auth is off -- so nobody needs to record it; it exists so the account is
# not passwordless at the console.
chpasswd:
  expire: false
  users:
    - name: ${admin_user}
      type: RAND

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - git
  - jq
  - htop
  - unattended-upgrades
%{ for pkg in extra_packages ~}
  - ${pkg}
%{ endfor ~}

write_files:
  - path: /etc/containerlabs/metadata.json
    permissions: "0644"
    content: |
      {
        "project": "${project}",
        "instance": "${instance_key}",
        "hostname": "${hostname}",
        "fqdn": "${fqdn}",
        "docker": ${docker},
        "managed_by": "opentofu"
      }

  # Key-only SSH, and no root at all: ${admin_user} (created above with the
  # account keys and passwordless sudo) is the way in.
  - path: /etc/ssh/sshd_config.d/99-containerlabs.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no

%{ if docker ~}
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" },
        "live-restore": true
      }

  # Kept as a script rather than inline runcmd entries so the shell quoting
  # survives YAML unmangled.
  - path: /opt/containerlabs/install-docker.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc

      . /etc/os-release
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $${VERSION_CODENAME} stable" \
        > /etc/apt/sources.list.d/docker.list

      apt-get update -qq
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin

      systemctl enable --now docker

      # Vultr's "limited" user scheme creates linuxuser; harmless if absent.
      if id linuxuser >/dev/null 2>&1; then
        usermod -aG docker linuxuser
      fi

  - path: /opt/containerlabs/install-containerlab.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      # Containerlab's apt repository (Gemfury) publishes no signing key;
      # trusted=yes is the documented install path.
      echo "deb [trusted=yes] https://netdevops.fury.site/apt/ /" \
        > /etc/apt/sources.list.d/netdevops.list

      apt-get update -qq
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq containerlab
%{ if img != null ~}

  # Root-only: this script embeds the object storage credentials.
  - path: /opt/containerlabs/fetch-ceos.sh
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      install -d -m 0755 -o ${admin_user} -g ${admin_user} '${img.directory}'

      # Signed S3 GET via curl's SigV4 support -- no aws-cli needed. The
      # signing region is the endpoint's first DNS label.
      curl -fsSL --retry 3 --retry-delay 5 \
        --user '${img.access_key}:${img.secret_key}' \
        --aws-sigv4 "aws:amz:${img.region}:s3" \
        -o '${img.directory}/${img.name}' \
        'https://${img.host}/${img.bucket}/${img.name}'

      # cEOS tarballs are root filesystem archives, not `docker save` output,
      # so they come in via `docker import`.
      docker import '${img.directory}/${img.name}' ceos:latest

      # Only the imported image is kept; the tarball is a build remain.
      rm -f '${img.directory}/${img.name}'
%{ endif ~}
%{ if course_repo != "" ~}

  - path: /opt/containerlabs/build-course-image.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      REPO_URL='${course_repo}'
      DEST="/home/${admin_user}/$(basename "$REPO_URL" .git)"

      if [ ! -d "$DEST/.git" ]; then
        sudo -u ${admin_user} git clone "$REPO_URL" "$DEST"
      fi

      docker build -t netcourse-host:latest "$DEST/common/host-image/"

      # The clone only exists to feed the build; re-clone to hack on it.
      rm -rf "$DEST"
%{ endif ~}
%{ endif ~}

runcmd:
%{ if docker ~}
  - [bash, /opt/containerlabs/install-docker.sh]
  - [bash, /opt/containerlabs/install-containerlab.sh]
%{ if img != null ~}
  - [bash, /opt/containerlabs/fetch-ceos.sh]
%{ endif ~}
%{ if course_repo != "" ~}
  - [bash, /opt/containerlabs/build-course-image.sh]
%{ endif ~}
  # Keep only the images: drop the build cache, dangling layers and the
  # one-shot scripts (fetch-ceos.sh embeds the object storage credentials).
  - [docker, builder, prune, -af]
  - [docker, image, prune, -f]
  - [bash, -c, "rm -f /opt/containerlabs/*.sh"]
%{ endif ~}
  - [systemctl, restart, ssh]
  - [touch, /etc/containerlabs/ready]

power_state:
  mode: reboot
  condition: test -f /var/run/reboot-required
  delay: 1
  message: Rebooting after cloud-init package upgrades
%{ if extra != null }
# ---- extra_cloud_init passthrough ----
${extra}
%{ endif ~}
