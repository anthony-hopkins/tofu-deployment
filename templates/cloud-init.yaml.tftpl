#cloud-config
# Managed by OpenTofu -- project=${project} instance=${instance_key}
#
# cloud-init only executes on FIRST BOOT. Editing this template and applying
# updates the user data Vultr has on file but changes nothing on a running
# machine; you must reinstall or rebuild the instance to re-run it.

hostname: ${hostname}
fqdn: ${fqdn}
manage_etc_hosts: true

users:
  - default
  - name: ${admin_user}
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - ${key}
%{ endfor ~}

# The random password is generated on the instance and printed only to the
# serial console log (Vultr web console). SSH never accepts it -- password
# auth is off -- so nobody needs to record it; it exists so the account is
# not passwordless at the console.
chpasswd:
  expire: false
  users:
    - name: ${admin_user}
      type: RAND

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - git
  - jq
  - htop
  - unattended-upgrades
%{ if hashcat ~}
  # hashcat, plus the OpenCL plumbing it will not start without. The default
  # plan has no GPU -- vx1-g-32c-128g reports gpu_brand "none"; the "g" is
  # "general purpose", not graphics -- so pocl is the runtime that actually
  # executes the kernels, across the 32 AMD threads.
  - hashcat
  - pocl-opencl-icd
  - ocl-icd-libopencl1
  - clinfo
  # A dictionary run against a large corpus outlives an SSH session.
  - tmux
  # Corpus handling: unpack, repack and move dictionaries around. "7zip", not
  # "p7zip-full" -- on 26.04 the latter is a transitional package built from
  # this source.
  - 7zip
  - pigz
  - xz-utils
  - zstd
  - rsync
%{ endif ~}
%{ for pkg in extra_packages ~}
  - ${pkg}
%{ endfor ~}

write_files:
  - path: /etc/crackbox/metadata.json
    permissions: "0644"
    content: |
      {
        "project": "${project}",
        "instance": "${instance_key}",
        "hostname": "${hostname}",
        "fqdn": "${fqdn}",
        "hashcat": ${hashcat},
        "data_mount": "${data_mount}",
        "managed_by": "opentofu"
      }

  # Key-only SSH, and no root at all: ${admin_user} (created above with the
  # account keys and passwordless sudo) is the way in.
  - path: /etc/ssh/sshd_config.d/99-crackbox.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no

%{ if hashcat ~}
  # Kept as a script rather than inline runcmd entries so the shell quoting
  # survives YAML unmangled.
  - path: /opt/crackbox/mount-data.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      MOUNT='${data_mount}'
      OWNER='${admin_user}'

      # The storage on a vx1-*-<n>s plan arrives as its own device rather than
      # as extra room on the root disk, and an attached block volume does the
      # same. Adopt the largest disk that is not the root disk and carries
      # nothing at all -- no filesystem, no partition table, no mount anywhere
      # in its tree. A device that already holds data belongs to somebody and
      # is left alone, which is also what makes this safe to re-run.
      root_src="$(findmnt -no SOURCE /)"
      root_disk="$(lsblk -no PKNAME "$root_src" 2>/dev/null | head -n1)"
      : "$${root_disk:=$(basename "$root_src")}"

      target=""
      target_size=0
      while read -r name size; do
        [ "$name" = "$root_disk" ] && continue

        # One line per node in the device's tree; any non-blank field means
        # the disk is already carrying something.
        if lsblk -nro FSTYPE,MOUNTPOINT "/dev/$name" | grep -q '[^[:space:]]'; then
          continue
        fi

        if [ "$size" -gt "$target_size" ]; then
          target="/dev/$name"
          target_size="$size"
        fi
      done < <(lsblk -dnb -o NAME,SIZE -e 1,7,11)

      if [ -n "$target" ]; then
        echo "crackbox: claiming $target ($((target_size / 1024 / 1024 / 1024)) GB) for $MOUNT"
        mkfs.ext4 -q -L crackdata "$target"
        uuid="$(blkid -s UUID -o value "$target")"
        mkdir -p "$MOUNT"

        # By UUID, because device names are not stable across a rebuild. nofail
        # so a missing or replaced volume degrades to an unmounted directory
        # rather than dropping the box into emergency mode at boot.
        printf 'UUID=%s %s ext4 defaults,noatime,nofail 0 2\n' "$uuid" "$MOUNT" \
          >>/etc/fstab
        systemctl daemon-reload
        mount "$MOUNT"
      else
        echo "crackbox: no spare disk; $MOUNT stays on the root filesystem"
      fi

      # Owned by ${admin_user} so cracking runs, potfiles and session restores
      # need no sudo.
      install -d -m 0755 -o "$OWNER" -g "$OWNER" \
        "$MOUNT" \
        "$MOUNT/wordlists" \
        "$MOUNT/hashes" \
        "$MOUNT/rules" \
        "$MOUNT/sessions"
%{ endif ~}

runcmd:
  # First, before the package work. The hardened sshd config written above is
  # inert until sshd reloads, and you will want to be uploading dictionaries
  # over a key-only sshd rather than one still accepting passwords.
  - [systemctl, restart, ssh]
%{ if hashcat ~}
  - [bash, /opt/crackbox/mount-data.sh]
  # Proof that the OpenCL runtime came up and hashcat can see the threads.
  # Recorded rather than asserted: a box whose backend failed should still
  # finish booting so you can log in and read this file.
  - [bash, -c, "hashcat -I >/etc/crackbox/backends.txt 2>&1 || true"]
%{ endif ~}
  - [touch, /etc/crackbox/ready]

power_state:
  mode: reboot
  condition: test -f /var/run/reboot-required
  delay: 1
  message: Rebooting after cloud-init package upgrades
%{ if extra != null }
# ---- extra_cloud_init passthrough ----
${extra}
%{ endif ~}
